# Database Configuration (for Docker: use 'postgres' as host)
DATABASE_URL=postgresql://postgres:postgres@postgres:5432/retiree_help
POSTGRES_HOST=localhost
POSTGRES_USER=postgres
POSTGRES_PORT=5432
POSTGRES_PASSWORD=postgres
POSTGRES_DB=retiree_help

# JWT Configuration
JWT_SECRET=your-secret-key-change-in-production
SECRET_KEY=secret
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
ACCESS_TOKEN_EXPIRE_HOURS=720

# S3/MinIO Configuration (for Docker: use 'minio' as endpoint)
S3_ENDPOINT=http://minio:9000
S3_ENDPOINT_LOCAL=localhost
S3_PORT=9000
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
S3_BUCKET_NAME=retiree-help
S3_BUCKET=uploads
S3_SECURE=false

# Frontend API URL
VITE_API_URL=http://localhost:8000

# Docker Services (exposed ports)
# PostgreSQL: localhost:5432
# MinIO: localhost:9000 (API), localhost:9001 (Console)
# Backend: localhost:8000
# Frontend: localhost:5173